/* app.wxss - 《为了变帅》全局样式（还原原版暖色调设计系统） */
page {
  /* 原版设计令牌（明主题） */
  --bg:#FAF9F6; --text:#141312; --muted:#9E9A93; --rule:#E8E5DF;
  --accent:#D4785C; --danger:#C44; --card:#fff; --shadow:rgba(0,0,0,.06);
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
  font-size: 15px;
  line-height: 1.3;
}
/* 所有容器（position:fixed 的弹层脱离了 .app 作用域）也要拿得到设计令牌，否则弹层会一片白/字色错乱 */
.app, .ov-page, .ov-mask, .ov-sheet {
  --bg:#FAF9F6; --text:#141312; --muted:#9E9A93; --rule:#E8E5DF;
  --accent:#D4785C; --danger:#C44; --card:#fff; --shadow:rgba(0,0,0,.06);
}
view, text, button, input, scroll-view, navigator { box-sizing: border-box; }
button { padding: 0; margin: 0; background: none; border: none; font-family: inherit; color: inherit; font-size: inherit; line-height: inherit; }
button::after { border: none; }
input { font-family: inherit; }
